@@ -0,0 +1,72 @@
+import datetime
+import json
+import math
+from pathlib import Path
+
+
+class ExponentialMovingAverage:
+    """Track a scalar EMA without bias correction."""
+
+    def __init__(self, decay):
+        decay = float(decay)
+        if not 0.0 <= decay < 1.0:
+            raise ValueError(f"decay must be in [0, 1), got {decay}")
+        self.decay = decay
+        self.value = None
+
+    def update(self, value):
+        value = float(value)
+        if not math.isfinite(value):
+            raise ValueError(f"EMA input must be finite, got {value}")
+        if self.value is None:
+            self.value = value
+        else:
+            self.value = self.decay * self.value + (1.0 - self.decay) * value
+        return self.value
+
+
+class ScalarMetricLogger:
+    """Write the same finite scalar stream to TensorBoard and JSONL."""
+
+    def __init__(self, log_dir, jsonl_name="scalars.jsonl"):
+        from torch.utils.tensorboard import SummaryWriter
+
+        self.log_dir = Path(log_dir).resolve()
+        self.log_dir.mkdir(parents=True, exist_ok=True)
+        self.jsonl_path = self.log_dir / jsonl_name
+        self._jsonl_file = self.jsonl_path.open("a", encoding="utf-8", buffering=1)
+        self._writer = SummaryWriter(log_dir=str(self.log_dir))
+        self._closed = False
+
+    def log(self, metrics, step, stage):
+        if self._closed:
+            raise RuntimeError("Cannot log metrics after ScalarMetricLogger.close()")
+        step = int(step)
+        if step < 0:
+            raise ValueError(f"step must be non-negative, got {step}")
+
+        scalar_metrics = {}
+        for name, value in metrics.items():
+            value = float(value)
+            if not math.isfinite(value):
+                raise ValueError(f"Metric {name!r} must be finite, got {value}")
+            scalar_metrics[str(name)] = value
+            self._writer.add_scalar(str(name), value, step)
+
+        payload = {
+            "recorded_at_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
+            "stage": str(stage),
+            "step": step,
+            "metrics": scalar_metrics,
+        }
+        self._jsonl_file.write(json.dumps(payload, sort_keys=True) + "\n")
+        self._writer.flush()
+
+    def close(self):
+        if self._closed:
+            return
+        self._writer.flush()
+        self._writer.close()
+        self._jsonl_file.close()
+        self._closed = True
+
