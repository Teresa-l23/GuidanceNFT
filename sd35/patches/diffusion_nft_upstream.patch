+            transformer_trainable_parameters,
+            config,
+            optimizer,
+            scaler,
+            v5flow_extension=v5flow_extension,
+            optimizer_v5=optimizer_v5,
+            v5_scaler=v5_scaler,
+            v5_ema=v5_ema,
+            v5_optimization_step=v5_optimization_step,
+            resume_epoch=active_epoch,
+            checkpoint_kind="final",
+            v5flow_enabled=v5flow_is_enabled,
+            training_method=training_method,
+            cfg_mode=cfg_mode,
+            rollout_guidance_scale=config.sample.guidance_scale,
+            cfg_contract_explicit=cfg_modes_extension is not None,
+        )
+        if world_size > 1:
+            dist.barrier()
+
+    def save_exact_resume_checkpoint(
+        *,
+        checkpoint_root,
+        checkpoint_kind,
+        resume_epoch,
+        resume_phase,
+        next_sampling_batch,
+        payload,
+    ):
+        if v5flow_extension is None:
+            raise RuntimeError("Exact checkpoints require the repository-local extension")
+        if checkpoint_kind not in {"requeue", "rolling"}:
+            raise ValueError(f"Unsupported exact checkpoint kind: {checkpoint_kind!r}")
+        if is_main_process(rank):
+            os.makedirs(checkpoint_root, exist_ok=True)
+            try:
+                os.unlink(os.path.join(checkpoint_root, CHECKPOINT_COMPLETE_MARKER))
+            except FileNotFoundError:
+                pass
+        if world_size > 1:
+            dist.barrier()
+
+        rng_state = v5flow_extension.capture_rng_state(device)
+        rank_state_path = v5flow_extension.save_requeue_rank_state(
+            checkpoint_dir=checkpoint_root,
+            rank=rank,
+            world_size=world_size,
+            checkpoint_step=global_step,
+            resume_epoch=resume_epoch,
+            resume_phase=resume_phase,
+            next_sampling_batch=next_sampling_batch,
+            rng_state=rng_state,
+            payload=payload,
+        )
+        logger.info(f"Rank {rank} saved {checkpoint_kind} rank state to {rank_state_path}")
+        if world_size > 1:
+            dist.barrier()
+
+        transformer_ddp.module.set_adapter("default")
+        save_ckpt(
+            config.save_dir,
+            transformer_ddp,
+            global_step,
+            rank,
+            ema,
+            transformer_trainable_parameters,
+            config,
+            optimizer,
+            scaler,
+            v5flow_extension=v5flow_extension,
+            optimizer_v5=optimizer_v5,
+            v5_scaler=v5_scaler,
+            v5_ema=v5_ema,
+            v5_optimization_step=v5_optimization_step,
+            resume_epoch=resume_epoch,
+            checkpoint_kind=checkpoint_kind,
+            v5flow_enabled=v5flow_is_enabled,
+            training_method=training_method,
+            cfg_mode=cfg_mode,
+            rollout_guidance_scale=config.sample.guidance_scale,
+            cfg_contract_explicit=cfg_modes_extension is not None,
+            save_root_override=checkpoint_root,
+            requeue_metadata={
+                "resume_phase": resume_phase,
+                "next_sampling_batch": next_sampling_batch,
+                "world_size": world_size,
+                "rank_state_files": [
+                    v5flow_extension.requeue_rank_state_filename(state_rank)
+                    for state_rank in range(world_size)
+                ],
+            },
+        )
+        if world_size > 1:
+            dist.barrier()
+        # Checkpoint serialization must be invisible to an uninterrupted run.
+        # This also makes the saved state the exact RNG point seen after return.
+        v5flow_extension.restore_rng_state(rng_state, device)
+
+    def save_requeue_checkpoint(*, resume_epoch, resume_phase, next_sampling_batch, payload):
+        if not requeue_result_file:
+            raise RuntimeError(
+                "DIFFUSION_NFT_REQUEUE_RESULT_FILE is required when cooperative requeue is enabled"
+            )
+        safe_phase = str(resume_phase).replace("/", "_")
+        restart_count = os.environ.get("SLURM_RESTART_COUNT", "0")
+        if not restart_count.isdecimal():
+            raise ValueError(f"Invalid SLURM_RESTART_COUNT: {restart_count!r}")
+        checkpoint_root = os.path.join(
+            config.save_dir,
+            "requeue",
+            f"requeue-r{restart_count}-step-{global_step}-epoch-{resume_epoch}-"
+            f"{safe_phase}-batch-{next_sampling_batch}",
+        )
+        save_exact_resume_checkpoint(
+            checkpoint_root=checkpoint_root,
+            checkpoint_kind="requeue",
+            resume_epoch=resume_epoch,
+            resume_phase=resume_phase,
+            next_sampling_batch=next_sampling_batch,
+            payload=payload,
+        )
+        if is_main_process(rank):
+            result_temporary = f"{requeue_result_file}.{os.getpid()}.tmp"
+            os.makedirs(os.path.dirname(requeue_result_file), exist_ok=True)
+            try:
+                with open(result_temporary, "x", encoding="utf-8") as result_file:
+                    result_file.write(os.path.abspath(checkpoint_root) + "\n")
+                    result_file.flush()
+                    os.fsync(result_file.fileno())
+                os.replace(result_temporary, requeue_result_file)
+            finally:
+                try:
+                    os.unlink(result_temporary)
+                except FileNotFoundError:
+                    pass
+            logger.info(
+                f"Cooperative requeue checkpoint is complete at {checkpoint_root}; exiting trainer cleanly."
+            )
+
+    def save_rolling_checkpoint(*, resume_epoch):
+        checkpoint_root = os.path.join(
+            config.save_dir,
+            "rolling",
+            f"checkpoint-{global_step}",
+        )
+        save_exact_resume_checkpoint(
+            checkpoint_root=checkpoint_root,
+            checkpoint_kind="rolling",
+            resume_epoch=resume_epoch,
+            resume_phase="outer_boundary",
+            next_sampling_batch=0,
+            payload=None,
+        )
+        if is_main_process(rank):
+            rolling_extension = v5flow_extension
+            pointer_path = rolling_extension.publish_rolling_checkpoint(
+                checkpoint_root, keep_generations=2
+            )
+            logger.info(
+                f"Published rolling checkpoint {checkpoint_root} through {pointer_path}; "
+                "retained the newest two complete generations."
+            )
+        if world_size > 1:
+            dist.barrier()
+
+    def requeue_requested_at_safe_point():
+        return distributed_requeue_requested(requeue_request_file, device, world_size)
+
+    def publish_v5flow_pretrain_requeue_result(checkpoint_root):
+        if not requeue_result_file:
+            raise RuntimeError(
+                "DIFFUSION_NFT_REQUEUE_RESULT_FILE is required for pretrain requeue"
+            )
+        if is_main_process(rank):
+            result_temporary = f"{requeue_result_file}.{os.getpid()}.tmp"
+            os.makedirs(os.path.dirname(requeue_result_file), exist_ok=True)
+            try:
+                with open(result_temporary, "x", encoding="utf-8") as result_file:
+                    result_file.write(os.path.abspath(checkpoint_root) + "\n")
+                    result_file.flush()
+                    os.fsync(result_file.fileno())
+                os.replace(result_temporary, requeue_result_file)
+            finally:
+                try:
+                    os.unlink(result_temporary)
+                except FileNotFoundError:
+                    pass
+        if world_size > 1:
+            dist.barrier()
+
+    def run_v5flow_warmup():
+        """Fit v5 on refreshable frozen-policy endpoint buffers.
+
+        Multi-refresh export-only runs checkpoint at every completed refresh.
+        The static holdout prompt groups are globally disjoint from every train
+        refresh, and holdout endpoint collection runs in an isolated RNG scope.
+        """
+
+        nonlocal v5_optimization_step
+        if not v5flow_warmup_is_enabled:
+            return False
+        warmup = config.v5flow.warmup
+        if config.resume_from:
+            if bool(warmup.export_only):
+                raise ValueError("export-only v5flow warm-up cannot resume a formal run")
+            logger.info(
+                "Skipping v5flow warm-up because a formal checkpoint was resumed; "
+                "the checkpoint already contains the persistent v5 state."
+            )
+            return False
+        if bool(warmup.export_only) and os.path.lexists(str(warmup.output_path)):
+            raise FileExistsError(
+                "Refusing to retrain or overwrite existing v5flow initializer: "
+                f"{warmup.output_path}"
+            )
+
+        train_batch_count = int(warmup.num_rollout_batches)
+        holdout_batch_count = int(warmup.num_holdout_batches)
+        num_refreshes = int(warmup.num_refreshes)
+        checkpoint_root = str(warmup.checkpoint_root)
+        updates_per_refresh = (
+            int(warmup.num_inner_epochs)
+            * train_batch_count
+            // int(warmup.gradient_accumulation_steps)
+        )
+        target_v5_step = num_refreshes * updates_per_refresh
+        warmup_prompt_pool = str(warmup.prompt_pool)
+        warmup_dataset = (
+            train_dataset if warmup_prompt_pool == "train" else test_dataset
+        )
+        warmup_prompt_file = os.path.realpath(warmup_dataset.file_path)
+        warmup_prompt_sha256 = v5flow_extension.sha256_file(warmup_prompt_file)
+        groups_per_global_batch = (
+            world_size
+            * int(config.sample.train_batch_size)
+            // int(config.sample.num_image_per_prompt)
+        )
+        train_prompt_groups = (
+            num_refreshes * train_batch_count * groups_per_global_batch
+        )
+        holdout_prompt_groups = holdout_batch_count * groups_per_global_batch
+        pretrain_metadata = v5flow_initializer_contract()
+        pretrain_metadata.update(
+            {
+                "pretrain_schema": 1,
+                "submission_config_sha256": os.environ[
+                    "DIFFUSION_NFT_CONFIG_SHA256"
+                ],
+                "global_training_seed": int(config.seed),
+                "warmup_seed": int(warmup.seed),
+                "warmup_num_refreshes": num_refreshes,
+                "warmup_train_batches_per_rank_per_refresh": train_batch_count,
+                "warmup_holdout_batches_per_rank": holdout_batch_count,
+                "warmup_inner_epochs_per_refresh": int(warmup.num_inner_epochs),
+                "warmup_train_timesteps": int(warmup.num_train_timesteps),
+                "warmup_gradient_accumulation_steps": int(
+                    warmup.gradient_accumulation_steps
+                ),
+                "warmup_timestep_sampling": str(warmup.timestep_sampling),
+                "target_v5_optimization_step": target_v5_step,
+                "warmup_prompt_pool": warmup_prompt_pool,
+                "warmup_prompt_file": warmup_prompt_file,
+                "warmup_prompt_sha256": warmup_prompt_sha256,
+                "warmup_prompt_pool_size": len(warmup_dataset),
+                "warmup_train_prompt_groups": train_prompt_groups,
+                "warmup_holdout_prompt_groups": holdout_prompt_groups,
+                "warmup_holdout_probe_seed": int(warmup.seed) + 2_000_000,
+                "lora_rank": 32,
+                "lora_alpha": 64,
+            }
+        )
+        invocation_rng_state = v5flow_extension.capture_rng_state(device)
+        completed_refreshes = 0
+        latest_checkpoint = None
+        if checkpoint_root:
+            latest_checkpoint = (
+                v5flow_extension.find_latest_v5flow_pretrain_checkpoint(
+                    checkpoint_root
+                )
+            )
+        if latest_checkpoint is not None:
+            (
+                v5_optimization_step,
+                completed_refreshes,
+                checkpoint_rng_state,
+            ) = v5flow_extension.load_v5flow_pretrain_checkpoint(
+                checkpoint_dir=latest_checkpoint,
+                model=transformer_ddp.module,
+                optimizer_v5=optimizer_v5,
+                v5_scaler=v5_scaler,
+                v5_ema=v5_ema,
+                map_location=device,
+                rank=rank,
+                world_size=world_size,
+                expected_metadata=pretrain_metadata,
+            )
+            if completed_refreshes > num_refreshes:
+                raise ValueError(
+                    "v5flow pretrain checkpoint exceeds configured refresh budget"
+                )
+            if v5_optimization_step != completed_refreshes * updates_per_refresh:
+                raise ValueError(
+                    "v5flow pretrain checkpoint cursor does not align with its "
+                    "optimizer step"
+                )
+            v5flow_extension.restore_rng_state(checkpoint_rng_state, device)
+            logger.info(
+                "Resumed v5flow pretrain from %s at refresh %d/%d, step %d/%d.",
+                latest_checkpoint,
+                completed_refreshes,
+                num_refreshes,
+                v5_optimization_step,
+                target_v5_step,
+            )
+        elif v5_optimization_step != 0:
+            raise ValueError("fresh v5flow pretrain must start at optimizer step zero")
+
+        logger.info(
+            "Starting v5flow pretrain with %d refreshes, %d train batches per "
+            "refresh, %d holdout batches, %d inner epochs per refresh, and "
+            "%d total optimizer updates per rank; prompt_pool=%s file=%s "
+            "sha256=%s has %d entries "
+            "for %d train plus %d disjoint holdout groups.",
+            num_refreshes,
+            train_batch_count,
+            holdout_batch_count,
+            int(warmup.num_inner_epochs),
+            target_v5_step,
+            warmup_prompt_pool,
+            warmup_prompt_file,
+            warmup_prompt_sha256,
+            len(warmup_dataset),
+            train_prompt_groups,
+            holdout_prompt_groups,
+        )
+
+        def collect_endpoint_samples(index_batches, description):
+            records = []
+            pipeline.transformer.eval()
+            transformer_ddp.module.set_adapter("old")
+            for sample_indices in tqdm(
+                index_batches,
+                desc=description,
+                disable=not is_main_process(rank),
+                position=0,
+            ):
+                examples = [warmup_dataset[index] for index in sample_indices]
+                prompts, _ = warmup_dataset.collate_fn(examples)
+                prompt_embeds, pooled_prompt_embeds = compute_text_embeddings(
+                    prompts,
+                    text_encoders,
+                    tokenizers,
+                    max_sequence_length=128,
+                    device=device,
+                )
+                with torch_autocast(enabled=enable_amp, dtype=mixed_precision_dtype):
+                    with torch.no_grad():
+                        with cfg_rollout_routing_context(
+                            pipeline.transformer,
+                            pretrained_null_cfg_extension=(
+                                pretrained_null_cfg_extension
+                            ),
+                            cfg_unconditional_source=cfg_unconditional_source,
+                            conditional_adapter="old",
+                            guidance_scale=config.sample.guidance_scale,
+                        ):
+                            _, endpoint_latents, _ = pipeline_with_logprob(
+                                pipeline,
+                                prompt_embeds=prompt_embeds,
+                                pooled_prompt_embeds=pooled_prompt_embeds,
+                                negative_prompt_embeds=sample_neg_prompt_embeds[: len(prompts)],
+                                negative_pooled_prompt_embeds=(
+                                    sample_neg_pooled_prompt_embeds[: len(prompts)]
+                                ),
+                                num_inference_steps=config.sample.num_steps,
+                                guidance_scale=config.sample.guidance_scale,
+                                output_type="pt",
+                                height=config.resolution,
+                                width=config.resolution,
+                                noise_level=config.sample.noise_level,
+                                deterministic=config.sample.deterministic,
+                                solver=config.sample.solver,
+                                model_type="sd3",
+                                decode_output=False,
+                                return_full_trajectory=False,
+                            )
+                records.append(
+                    {
+                        "prompt_embeds": prompt_embeds,
+                        "pooled_prompt_embeds": pooled_prompt_embeds,
+                        "timesteps": pipeline.scheduler.timesteps.repeat(
+                            len(prompts), 1
+                        ).to(device),
+                        "latents_clean": endpoint_latents[-1],
+                    }
+                )
+            transformer_ddp.module.set_adapter("default")
+            return {
+                key: torch.cat([record[key] for record in records], dim=0)
+                for key in records[0]
+            }
+
+        try:
+            # One seeded permutation makes every train refresh and the holdout
+            # globally prompt-disjoint. It does not consume the training RNG.
+            all_index_batches = (
+                v5flow_extension.fixed_distributed_k_repeat_batches(
+                    dataset_size=len(warmup_dataset),
+                    batch_size=config.sample.train_batch_size,
+                    k=config.sample.num_image_per_prompt,
+                    num_replicas=world_size,
+                    rank=rank,
+                    num_batches=(num_refreshes * train_batch_count)
+                    + holdout_batch_count,
+                    seed=int(warmup.seed),
+                )
+            )
+            holdout_indices = all_index_batches[
+                num_refreshes * train_batch_count :
+            ]
+            continuation_rng_state = v5flow_extension.capture_rng_state(device)
+            set_seed(int(warmup.seed) + 1_000_000, rank)
+            warmup_holdout_samples = collect_endpoint_samples(
+                holdout_indices,
+                "v5flow pretrain: fixed holdout collection",
+            )
+            v5flow_extension.restore_rng_state(continuation_rng_state, device)
+            set_seed(int(warmup.seed) + 2_000_000, rank)
+            holdout_probe_rng_state = v5flow_extension.capture_rng_state(device)
+            v5flow_extension.restore_rng_state(continuation_rng_state, device)
+            holdout_before = v5flow_extension.evaluate_v5flow_fm_loss(
+                model=transformer_ddp.module,
+                samples=warmup_holdout_samples,
+                num_batches=holdout_batch_count,
+                num_train_timesteps=int(warmup.num_train_timesteps),
+                mixed_precision_dtype=mixed_precision_dtype,
+                world_size=world_size,
+                timestep_sampling=str(warmup.timestep_sampling),
+                probe_rng_state=holdout_probe_rng_state,
+            )
+
+            for refresh_index in range(completed_refreshes, num_refreshes):
+                train_start = refresh_index * train_batch_count
+                train_end = train_start + train_batch_count
+                warmup_train_samples = collect_endpoint_samples(
+                    all_index_batches[train_start:train_end],
+                    "v5flow pretrain: endpoint refresh "
+                    f"{refresh_index + 1}/{num_refreshes}",
+                )
+                step_before = v5_optimization_step
+                v5_optimization_step, warmup_metrics = (
+                    v5flow_extension.train_v5flow_epoch(
+                        model=transformer_ddp.module,
+                        samples=warmup_train_samples,
+                        num_batches=train_batch_count,
+                        num_train_timesteps=int(warmup.num_train_timesteps),
+                        num_inner_epochs=int(warmup.num_inner_epochs),
+                        gradient_accumulation_steps=int(
+                            warmup.gradient_accumulation_steps
+                        ),
+                        optimizer=optimizer_v5,
+                        scaler=v5_scaler,
+                        mixed_precision_dtype=mixed_precision_dtype,
+                        parameters=v5_transformer_parameters,
+                        ema=v5_ema,
+                        optimization_step=v5_optimization_step,
+                        max_grad_norm=config.v5flow.max_grad_norm,
+                        world_size=world_size,
+                        timestep_sampling=str(warmup.timestep_sampling),
+                    )
+                )
+                if v5_optimization_step - step_before != updates_per_refresh:
+                    raise RuntimeError(
+                        "v5flow pretrain refresh produced an unexpected optimizer "
+                        "update count"
+                    )
+                completed_refreshes = refresh_index + 1
+                holdout_after = v5flow_extension.evaluate_v5flow_fm_loss(
+                    model=transformer_ddp.module,
+                    samples=warmup_holdout_samples,
+                    num_batches=holdout_batch_count,
+                    num_train_timesteps=int(warmup.num_train_timesteps),
+                    mixed_precision_dtype=mixed_precision_dtype,
+                    world_size=world_size,
+                    timestep_sampling=str(warmup.timestep_sampling),
+                    probe_rng_state=holdout_probe_rng_state,
+                )
+
+                metric_names = sorted(warmup_metrics)
+                metric_values = torch.tensor(
+                    [warmup_metrics[name] for name in metric_names],
+                    device=device,
+                    dtype=torch.float64,
+                )
+                if world_size > 1:
+                    dist.all_reduce(metric_values, op=dist.ReduceOp.AVG)
+                if is_main_process(rank):
+                    reduced_metrics = {
+                        name.replace("v5flow/", "v5flow_pretrain/"): float(
+                            metric_values[index].item()
+                        )
+                        for index, name in enumerate(metric_names)
+                    }
+                    reduced_metrics.update(
+                        {
+                            "v5flow_pretrain/refresh": float(completed_refreshes),
+                            "v5flow_pretrain/holdout_fm_loss_before": holdout_before,
+                            "v5flow_pretrain/holdout_fm_loss_after": holdout_after,
+                            "v5flow_pretrain/holdout_fm_loss_delta": (
+                                holdout_after - holdout_before
+                            ),
+                            "v5flow_pretrain/fresh_endpoints_global": float(
+                                train_batch_count
+                                * config.sample.train_batch_size
+                                * world_size
+                            ),
+                            "v5flow_pretrain/cumulative_fresh_endpoints_global": float(
+                                completed_refreshes
+                                * train_batch_count
+                                * config.sample.train_batch_size
+                                * world_size
+                            ),
+                            "v5flow_pretrain/holdout_endpoints_global": float(
+                                holdout_batch_count
+                                * config.sample.train_batch_size
+                                * world_size
+                            ),
+                        }
+                    )
+                    wandb.log(reduced_metrics, step=v5_optimization_step)
+                    metric_logger.log(
+                        reduced_metrics,
+                        step=v5_optimization_step,
+                        stage="v5flow_pretrain",
+                    )
+                    logger.info(
+                        "Completed v5flow pretrain refresh %d/%d at step %d/%d: "
+                        "holdout FM loss %.6f -> %.6f (delta=%+.6f).",
+                        completed_refreshes,
+                        num_refreshes,
+                        v5_optimization_step,
+                        target_v5_step,
+                        holdout_before,
+                        holdout_after,
+                        holdout_after - holdout_before,
+                    )
+                holdout_before = holdout_after
+                del warmup_train_samples
+
+                completed_checkpoint = None
+                if checkpoint_root:
+                    completed_checkpoint = os.path.join(
+                        checkpoint_root,
+                        f"checkpoint-{v5_optimization_step}",
+                    )
+                    checkpoint_rng_state = v5flow_extension.capture_rng_state(device)
+                    v5flow_extension.save_v5flow_pretrain_checkpoint(
+                        output_dir=completed_checkpoint,
+                        model=transformer_ddp.module,
+                        optimizer_v5=optimizer_v5,
+                        v5_scaler=v5_scaler,
+                        v5_ema=v5_ema,
+                        v5_optimization_step=v5_optimization_step,
+                        completed_refreshes=completed_refreshes,
+                        rng_state=checkpoint_rng_state,
+                        rank=rank,
+                        world_size=world_size,
+                        metadata=pretrain_metadata,
+                    )
+                    if is_main_process(rank):
+                        v5flow_extension.prune_v5flow_pretrain_checkpoints(
+                            checkpoint_root,
+                            keep=int(warmup.keep_checkpoints),
+                        )
+                    if world_size > 1:
+                        dist.barrier()
+                    v5flow_extension.restore_rng_state(
+                        checkpoint_rng_state,
+                        device,
+                    )
+
+                if requeue_requested_at_safe_point():
+                    if completed_checkpoint is None:
+                        raise RuntimeError(
+                            "v5flow pretrain received a requeue request without a "
+                            "configured checkpoint_root"
+                        )
+                    publish_v5flow_pretrain_requeue_result(completed_checkpoint)
+                    logger.info(
+                        "v5flow pretrain checkpointed refresh %d/%d for cooperative "
+                        "requeue: %s",
+                        completed_refreshes,
+                        num_refreshes,
+                        completed_checkpoint,
+                    )
