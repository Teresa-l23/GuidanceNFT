{
  "schema_version": 7,
  "task": "owt",
  "base_config": "src/configs/training_configs/train_owt_ELF-B.yml",
  "pretrained_checkpoint": "embedded-language-flows/ELF-B-owt",
  "parameterization": "full_shared",
  "method": "standard",
  "output_dir": "${GUIDANCENFT_ASSETS}/runs/elf_nft/branch_ablations/owt_w1_paired_standard_100",
  "seed": 42,
  "sampling": {
    "method": "sde",
    "num_steps": 32,
    "time_schedule": "logit_normal",
    "sde_gamma": 1.5,
    "cfg_scale": 1,
    "self_cond_cfg_scale": 1
  },
  "rollout": {
    "prompt_groups_per_outer": 1,
    "samples_per_prompt": 384,
    "generation_batch_size": 8,
    "max_outer_steps": 100
  },
  "reward": {
    "type": "causal_lm_loglik",
    "model_name": "gpt2-large",
    "batch_size": 2,
    "max_length": 1024,
    "empty_text_reward": -20,
    "combination": {
      "mode": "adaptive_entropy_floor",
      "entropy_target": 5.1,
      "initial_entropy_weight": 0.25,
      "max_entropy_weight": 0.5,
      "entropy_ema_decay": 0.9,
      "dual_learning_rate": 0.05
    }
  },
  "training": {
    "batch_size": 16,
    "num_inner_epochs": 1,
    "learning_rate": 3e-05,
    "weight_decay": 0,
    "beta": 1,
    "kl_beta": 0.1,
    "decoder_ce_weight": 0.25,
    "adv_clip_max": 5,
    "max_grad_norm": 1,
    "old_policy_decay_type": 1,
    "self_cond_update_probability": 0.5,
    "self_condition_mode": "paired",
    "timestep_schedule": "logit_normal",
    "timesteps_per_batch": 8
  },
  "center": {
    "learning_rate": 3e-05,
    "num_inner_epochs": 1,
    "ema_decay": 0.9,
    "snapshot": "ema"
  },
  "checkpoint": {
    "save_every": 1,
    "keep": 3,
    "keep_every": 25
  },
  "logging": {
    "use_wandb": false,
    "wandb_project": "elf-nft",
    "wandb_run_name": "owt_w1_paired_standard_100"
  },
  "evaluation": {
    "cases": [
      {
        "name": "w1_external_cfg1",
        "model_cfg_scale": 1,
        "external_cfg_scale": 1
      },
      {
        "name": "w1_external_cfg3",
        "model_cfg_scale": 1,
        "external_cfg_scale": 3
      },
      {
        "name": "native_w3",
        "model_cfg_scale": 3,
        "external_cfg_scale": 1
      }
    ],
    "num_samples": 1024,
    "at_start": true,
    "at_end": true,
    "midpoint": false
  },
  "formal_experiment": true
}
