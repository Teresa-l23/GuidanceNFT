+def apply_lora_delta(x, lora_params=None, scale=1.0):
+    """Return a LoRA delta for a Dense input without registering base params.
+
+    ``lora_params`` is an external pytree with ``a`` shaped ``[in, rank]`` and
+    ``b`` shaped ``[rank, out]``.  Keeping it outside Linen's ``params``
+    collection lets NFT freeze the exact pretrained ELF tree and maintain
+    independent current/old/center adapters.  ``scale`` is normally
+    ``lora_alpha / rank``.
+    """
+    if lora_params is None:
+        return None
+    a = lora_params["a"]
+    b = lora_params["b"]
+    if x.shape[-1] != a.shape[0] or a.shape[1] != b.shape[0]:
+        raise ValueError(
+            "Invalid LoRA shapes: "
+            f"input={x.shape[-1]}, a={a.shape}, b={b.shape}"
+        )
+    delta = jnp.matmul(jnp.matmul(x.astype(a.dtype), a), b)
+    return (delta * jnp.asarray(scale, dtype=delta.dtype)).astype(x.dtype)
