+def load_pretrained_params(
+    checkpoint_path: str,
+    params_template: Any,
+    *,
+    revision: str | None = None,
+) -> Tuple[Any, int]:
+    """Load only the immutable model parameters needed for inference/fine-tuning.
+
+    Released ELF checkpoints may intentionally omit optimizer state.  Building a
+    full ``TrainState`` target would then either require the original optimizer
+    structure or fail on the missing ``opt_state`` leaf.  This loader restores
+    only ``params``, ``ema_params1``, and ``step`` and returns the EMA tree when
+    present.  Extra checkpoint leaves are ignored by Flax deserialization.
+    """
+
+    if not checkpoint_path:
+        raise ValueError("checkpoint_path must be nonempty")
+
+    log_for_0(f"Loading pretrained ELF parameters from {checkpoint_path}...")
+    target = {
+        "params": params_template,
+        "ema_params1": params_template,
+        "step": 0,
+    }
+    checkpoint, loaded_from = None, None
+    errors = []
+    local_path = _local_path(checkpoint_path)
+
+    if os.path.exists(local_path):
+        try:
+            checkpoint = _restore_checkpoint(local_path, target)
+            loaded_from = "local"
+        except Exception as error:
+            errors.append(f"local: {error}")
+
+    if checkpoint is None:
+        try:
+            hf_path = _download_hf_checkpoint(
+                checkpoint_path, revision=revision
+            )
+            if hf_path:
+                checkpoint = _restore_checkpoint(hf_path, target)
+                loaded_from = "HF"
+        except Exception as error:
+            errors.append(f"HF: {error}")
+
+    if checkpoint is None:
+        raise ValueError(
+            f"Failed to load pretrained parameters from {checkpoint_path}. "
+            f"Tried: {'; '.join(errors)}"
+        )
+    if "params" not in checkpoint:
+        raise ValueError("pretrained checkpoint restore is missing params")
+
+    selected_params = checkpoint.get("ema_params1", checkpoint["params"])
+    if selected_params is None:
+        selected_params = checkpoint["params"]
+    params = jax.tree_util.tree_map(jnp.array, selected_params)
+    step = int(checkpoint.get("step", 0))
+    log_for_0(f"Loaded immutable pretrained parameters from {loaded_from} at step {step}")
+    return params, step
